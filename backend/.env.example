# Bitey IA Web — local/free-first model routing
BITEY_COST_MODE=free_only
BITEY_FREE_ONLY_HARD_STOP=true
BITEY_ALLOW_CLOUD=false
BITEY_NATIVE_MODEL_ENABLED=true

# Ollama runs on the user's machine by default.
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Leave empty to use the first installed Ollama model, or set an exact tag.
OLLAMA_MODEL=
# Optional local fallback order. Bitey never downloads models automatically.
OLLAMA_FALLBACK_MODELS=qwen3:4b,llama3.2:3b,gemma3:4b
OLLAMA_TIMEOUT=45
OLLAMA_TEMPERATURE=0.2

# Canonical persistent memory / knowledge
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional external providers — disabled by default.
# Set BITEY_ALLOW_CLOUD=true only after explicitly authorizing cloud use.
OPENROUTER_ENABLED=false
OPENROUTER_API_KEY=
GROQ_ENABLED=false
GROQ_API_KEY=
GROQ_FREE_ONLY_CONFIRMED=false
